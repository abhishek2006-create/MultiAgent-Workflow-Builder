POSTGRES_USER=workflow
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=workflow_builder
DATABASE_URL=postgresql://workflow:local_dev_only@localhost:5432/workflow_builder?schema=public
API_PORT=3001
WEB_ORIGIN=http://localhost:3002
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=replace-with-a-random-shared-service-secret
AI_REQUEST_TIMEOUT_MS=120000
JWT_SECRET=replace-with-a-long-random-development-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3002/api/auth/google/callback
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3002/api/auth/github/callback

# Copy this file to .env before starting the API locally:
# docker compose up -d postgres
# npm --workspace apps/api run prisma:generate
# npm --workspace apps/api run prisma:migrate
# npm --workspace apps/api run start:dev
# docker compose logs -f api ai
# [guid]::NewGuid().ToString("N")
# docker compose up -d --build ai
