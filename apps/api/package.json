{
  "name": "@retail-support/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "node ../../scripts/api-dev.mjs",
    "prestart:dev": "npm run db:up --prefix ../.. && npm run db:migrate:deploy --prefix ../..",
    "start:prod": "node dist/src/main.js",
    "test": "npm run build && node --test test/*.test.cjs",
