POSTGRES_USER=workflow
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=workflow_builder
DATABASE_URL=postgresql://workflow:local_dev_only@localhost:5432/workflow_builder?schema=public
API_PORT=3001
WEB_ORIGIN=http://localhost:3002
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=replace-with-a-random-shared-service-secret
JWT_SECRET=replace-with-a-long-random-development-secret
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.5
OPENAI_ALLOWED_MODELS=gpt-5.5,gpt-6-astra
AI_PROVIDER_TIMEOUT_MS=60000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

# Copy this file to .env before starting containers:
# cp .env.example .env
# docker compose up --build -d
# docker compose logs -f api ai

# Enable explicitly for workflows containing a Web Search node.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MODEL=gemini-3.5-flash-lite
